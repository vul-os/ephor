# JS build artifacts
node_modules/
dist-lib/
/dist/

# Go build artifacts (sovereign reverse tunnel)
/vulos-relayd
/vulos-relay-agent

# Databases
*.db

# Self-host secrets generated by scripts/install.sh — NEVER commit these.
/.env
/grants.json
/revoked.json

# macOS + IDE
.DS_Store
.claude

# Screenshots — generated by `npm run screenshots`
# Commit the outputs (site/screenshots/*.png) so the docs site and the docs/
# copy both render without a local capture run. docs/screenshots/ no longer
# exists: it held the deleted demo harness's captures, not Pier's.
# Ignore only the Playwright cache that the scripts/ install pulls in.
scripts/node_modules/
scripts/package-lock.json

# Rust build output
/target
# `crates/pier-billing-patala` is EXCLUDED from the root workspace (it path-depends on the
# sibling patala repo), so it is its own workspace root and builds into its own target/.
/crates/pier-billing-patala/target
