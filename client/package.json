{
  "name": "pier-client",
  "private": false,
  "version": "0.3.0",
  "description": "JS client SDK for the Pier peer-fabric — endpoint failover, offline bootstrap, WebRTC signaling, presence, live cursors. Talks to the host application's peering backend over HTTP/WebSocket.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "notices": "node ../scripts/gen-third-party-notices.mjs --npm-start . --out THIRD-PARTY-NOTICES.txt --title \"pier-client (browser bundle)\"",
    "build": "npm run notices && vite build --config vite.config.lib.js && npm run build:types",
    "build:lib": "vite build --config vite.config.lib.js",
    "build:types": "tsc -p tsconfig.dts.json",
    "build:harness": "vite build --config e2e/harness/vite.config.js",
    "test": "npm run kotva:check && vitest run",
    "kotva:check": "node scripts/check-kotva-parity.mjs",
    "check:lint-config": "node scripts/check-lint-config.mjs",
    "kotva:pin": "node scripts/check-kotva-parity.mjs --repin",
    "pretest:e2e": "npm run build && npm run build:harness",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "main": "./dist-lib/index.cjs",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "require": "./dist-lib/index.cjs",
      "default": "./dist-lib/index.js"
    },
    "./errors": {
      "source": "./src/errors.ts",
      "types": "./dist-lib/errors.d.ts",
      "import": "./dist-lib/errors.js",
      "require": "./dist-lib/errors.cjs",
      "default": "./dist-lib/errors.js"
    },
    "./endpoints": {
      "source": "./src/endpoints.ts",
      "types": "./dist-lib/endpoints.d.ts",
      "import": "./dist-lib/endpoints.js",
      "require": "./dist-lib/endpoints.cjs",
      "default": "./dist-lib/endpoints.js"
    },
    "./offlineBootstrap": {
      "source": "./src/offlineBootstrap.ts",
      "types": "./dist-lib/offlineBootstrap.d.ts",
      "import": "./dist-lib/offlineBootstrap.js",
      "require": "./dist-lib/offlineBootstrap.cjs",
      "default": "./dist-lib/offlineBootstrap.js"
    },
    "./signaling": {
      "source": "./src/signaling.ts",
      "types": "./dist-lib/signaling.d.ts",
      "import": "./dist-lib/signaling.js",
      "require": "./dist-lib/signaling.cjs",
      "default": "./dist-lib/signaling.js"
    },
    "./fabric": {
      "source": "./src/fabric.ts",
      "types": "./dist-lib/fabric.d.ts",
      "import": "./dist-lib/fabric.js",
      "require": "./dist-lib/fabric.cjs",
      "default": "./dist-lib/fabric.js"
    },
    "./rendezvous": {
      "source": "./src/rendezvous.ts",
      "types": "./dist-lib/rendezvous.d.ts",
      "import": "./dist-lib/rendezvous.js",
      "require": "./dist-lib/rendezvous.cjs",
      "default": "./dist-lib/rendezvous.js"
    },
    "./rendezvousSignaling": {
      "source": "./src/rendezvousSignaling.ts",
      "types": "./dist-lib/rendezvousSignaling.d.ts",
      "import": "./dist-lib/rendezvousSignaling.js",
      "require": "./dist-lib/rendezvousSignaling.cjs",
      "default": "./dist-lib/rendezvousSignaling.js"
    },
    "./chunkProof": {
      "source": "./src/chunkProof.ts",
      "types": "./dist-lib/chunkProof.d.ts",
      "import": "./dist-lib/chunkProof.js",
      "require": "./dist-lib/chunkProof.cjs",
      "default": "./dist-lib/chunkProof.js"
    },
    "./presence": {
      "source": "./src/presence.ts",
      "types": "./dist-lib/presence.d.ts",
      "import": "./dist-lib/presence.js",
      "require": "./dist-lib/presence.cjs",
      "default": "./dist-lib/presence.js"
    },
    "./call": {
      "source": "./src/call/index.ts",
      "types": "./dist-lib/call/index.d.ts",
      "import": "./dist-lib/call.js",
      "require": "./dist-lib/call.cjs",
      "default": "./dist-lib/call.js"
    },
    "./useLiveCursors": {
      "source": "./src/useLiveCursors.ts",
      "types": "./dist-lib/useLiveCursors.d.ts",
      "import": "./dist-lib/useLiveCursors.js",
      "require": "./dist-lib/useLiveCursors.cjs",
      "default": "./dist-lib/useLiveCursors.js"
    },
    "./health": {
      "source": "./src/health.ts",
      "types": "./dist-lib/health.d.ts",
      "import": "./dist-lib/health.js",
      "require": "./dist-lib/health.cjs",
      "default": "./dist-lib/health.js"
    },
    "./roundTripCheck": {
      "source": "./src/roundTripCheck.ts",
      "types": "./dist-lib/roundTripCheck.d.ts",
      "import": "./dist-lib/roundTripCheck.js",
      "require": "./dist-lib/roundTripCheck.cjs",
      "default": "./dist-lib/roundTripCheck.js"
    },
    "./regionPop": {
      "source": "./src/regionPop.ts",
      "types": "./dist-lib/regionPop.d.ts",
      "import": "./dist-lib/regionPop.js",
      "require": "./dist-lib/regionPop.cjs",
      "default": "./dist-lib/regionPop.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib/",
    "src/",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "xlsx": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.7",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  }
}
