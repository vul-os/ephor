# /etc/vulos-relayd/relayd.env — configuration for the vulos-relayd systemd unit.
#
#   sudo install -Dm600 deploy/relayd.env.example /etc/vulos-relayd/relayd.env
#   sudo editor /etc/vulos-relayd/relayd.env      # fill in the values below
#
# Keep this file mode 0600, owner root — VULOS_RELAY_TOKENS holds bearer
# credentials (anyone with a token can claim its granted names).

# REQUIRED — your relay's base domain (no scheme). Tunnels are served at
# https://<name>.relay.example.com (subdomain mode) or
# https://relay.example.com/t/<name>/ (path mode).
VULOS_RELAY_DOMAIN=relay.example.com

# REQUIRED — agent grants: a JSON array of {token, names}. Generate a strong
# token with `openssl rand -hex 32`. A token may serve ONLY the names listed.
VULOS_RELAY_TOKENS=[{"token":"REPLACE-WITH-openssl-rand-hex-32","names":["box1"]}]

# Listen address. The golden path binds LOOPBACK and lets Caddy (or any TLS
# terminator) proxy to it, so the relay's plain-HTTP port is never public.
VULOS_RELAY_ADDR=127.0.0.1:8443

# Caddy/your edge terminates TLS and sets X-Forwarded-For, so trust it (=1) to
# preserve the real client IP. Set to empty ONLY if the relay is DIRECTLY
# internet-facing (then it overwrites X-Forwarded-* to stop client IP spoofing).
VULOS_RELAY_TRUST_PROXY_HEADERS=1

# Set to 1 for PATH MODE (single hostname, no wildcard DNS/cert needed):
# tunnels at https://relay.example.com/t/<name>/. Leave empty for subdomain mode.
VULOS_RELAY_PATH_MODE=1

# Admin/metrics listener (/metrics, /healthz, /readyz). Keep it loopback — a
# routable bind refuses to start without VULOS_RELAY_METRICS_TOKEN.
VULOS_RELAY_ADMIN_ADDR=127.0.0.1:9090

# ── Optional: control-plane account-linking + metering. Leave unset to run
#    UNBILLED self-host (tokens authorized, nothing metered, no account needed).
#VULOS_CP_URL=
#CP_SHARED_SECRET=
#VULOS_RELAY_POP_ID=
