# /etc/vulos-relay-agent/agent.env — configuration for the agent systemd unit.
# This lives ON THE BOX you are exposing, not on the relay host.
#
#   sudo install -Dm600 deploy/agent.env.example /etc/vulos-relay-agent/agent.env
#   sudo editor /etc/vulos-relay-agent/agent.env
#
# Mode 0600, owner root — VULOS_RELAY_TOKEN is a bearer credential.

# The relay's wss:// URL (subdomain or path mode both dial the apex host here).
VULOS_RELAY_SERVER=wss://relay.example.com

# One of the tokens from the relay's grants, and a name that token is granted.
VULOS_RELAY_TOKEN=REPLACE-WITH-THE-SAME-TOKEN-FROM-THE-RELAY-GRANT
VULOS_RELAY_NAME=box1

# The local loopback target is passed as -local in the unit's ExecStart
# (default 127.0.0.1:8080). Edit the unit if your service listens elsewhere.
