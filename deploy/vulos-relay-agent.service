[Unit]
# Ephor relay agent (vulos-relay-agent) — runs ON THE BOX you want to expose,
# NOT on the relay host. It dials ONE outbound wss:// connection to the relay;
# it binds nothing inbound and forwards only to its one loopback target.
Description=Ephor relay agent (vulos-relay-agent)
Documentation=https://github.com/vul-os/ephor/blob/main/docs/CLOUD-SETUP.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# server/token/name come from the env file (VULOS_RELAY_SERVER,
# VULOS_RELAY_TOKEN, VULOS_RELAY_NAME). -local has no env twin, so it is passed
# as a flag below — point it at the loopback service you want to publish.
# Keep this file 0600 root:root — VULOS_RELAY_TOKEN is a bearer credential.
EnvironmentFile=/etc/vulos-relay-agent/agent.env
ExecStart=/usr/local/bin/vulos-relay-agent -local 127.0.0.1:8080
Restart=always
RestartSec=2s

KillSignal=SIGTERM
TimeoutStopSec=15s

# ── Hardening — the agent needs only outbound network + loopback dial ─────────
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
