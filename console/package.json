{
  "name": "pier-console",
  "private": true,
  "version": "0.1.0",
  "description": "Operator console — a rebrandable Svelte web UI for the pier-admin crate's coordinator control plane.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "lint": "eslint .",
    "check:lint-config": "node scripts/check-lint-config.mjs",
    "check:brand": "bash scripts/check-brand-isolation.sh",
    "check:brand:mutate": "bash scripts/mutation-test-brand-isolation.sh",
    "screenshot": "node scripts/screenshot.mjs",
    "review": "node scripts/review.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "playwright": "^1.61.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.1"
  }
}
