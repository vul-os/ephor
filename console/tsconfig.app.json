{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "types": ["svelte", "vite/client"],
    "allowArbitraryExtensions": true,
    /* Mirrors the `$brand` alias vite.config.ts resolves from VITE_BRAND. The
       mapping is pinned to the default brand because a tsconfig cannot read an
       env var; every brand module exports the same `Brand`, so typechecking one
       typechecks the shape all of them must satisfy. */
    "paths": { "$brand": ["./src/brands/pier.ts"] },
    "noEmit": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "moduleDetection": "force",
    /* Measured in isolation before enabling (see lint-eslint branch history):
       noUncheckedIndexedAccess surfaced 2 errors in 2 files, exactOptionalPropertyTypes
       surfaced 0. Both are cheap here, unlike client/ where exactOptionalPropertyTypes
       hits a kotva-pinned file and noUncheckedIndexedAccess surfaces real
       behavioural-judgement call sites, so client/ keeps neither. */
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
